{
  "name": "@pbl4/protocol",
  "version": "0.1.0",
  "private": true,
  "description": "Shared wire contract (REST, WebSocket, DataChannel) as zod schemas — single source of truth (ADR-007)",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@pbl4/config": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.11",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
